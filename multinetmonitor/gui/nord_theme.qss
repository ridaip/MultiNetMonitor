QWidget {
    background-color: #2e3440;
    color: #eceff4;
    font-family: 'Inter', 'Segoe UI', 'Roboto', sans-serif;
    font-size: 13px;
}

QPushButton {
    background-color: #3b4252;
    border: 1px solid #4c566a;
    border-radius: 6px;
    padding: 5px 10px;
    color: #eceff4;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #4c566a;
    border: 1px solid #88c0d0;
    color: #88c0d0;
}
QPushButton:pressed {
    background-color: #88c0d0;
    color: #2e3440;
}

#EditBtn {
    border: 1px solid #4c566a;
    color: #88c0d0;
    background-color: #3b4252;
}
#EditBtn:hover {
    background-color: rgba(136, 192, 208, 0.2);
    border-color: #88c0d0;
}

#PinBtn {
    border: 1px solid #4c566a;
    background-color: #3b4252;
    color: #eceff4;
}
#PinBtn:checked {
    background-color: rgba(136, 192, 208, 0.25);
    border: 1px solid #88c0d0;
    color: #88c0d0;
}

#DeleteBtn {
    border: 1px solid #bf616a;
    background-color: rgba(191, 97, 106, 0.15);
    color: #bf616a;
}
#DeleteBtn:hover {
    background-color: #bf616a;
    color: #eceff4;
}

#CloseBtn {
    border: none;
    background: transparent;
    font-size: 14px;
    color: #d8dee9;
    border-radius: 4px;
}
#CloseBtn:hover {
    background-color: #bf616a;
    color: #eceff4;
}

#ToolBtn {
    border: 1px solid #4c566a;
    background-color: #3b4252;
    color: #eceff4;
}
#ToolBtn:hover {
    border-color: #88c0d0;
    color: #88c0d0;
}

QLineEdit, QComboBox, QTableWidget {
    background-color: #3b4252;
    border: 1px solid #4c566a;
    border-radius: 6px;
    padding: 6px;
    color: #eceff4;
}
QLineEdit:focus, QComboBox:focus, QTableWidget:focus {
    border: 1px solid #88c0d0;
    outline: none;
}

QGroupBox {
    border: 1px solid #4c566a;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    background-color: #3b4252;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #88c0d0;
}

QHeaderView::section {
    background-color: #3b4252;
    color: #88c0d0;
    border: none;
    border-right: 1px solid #4c566a;
    padding: 6px;
    font-weight: bold;
}

QProgressBar {
    border: 1px solid #4c566a;
    border-radius: 6px;
    text-align: center;
    background-color: #2e3440;
    color: #eceff4;
}
QProgressBar::chunk {
    background-color: #88c0d0;
    border-radius: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #4c566a;
    background: #3b4252;
}
QCheckBox::indicator:checked {
    background: #88c0d0;
    border-color: #88c0d0;
}

#TargetRow {
    background-color: #3b4252;
    border-radius: 6px;
    border: 1px solid #4c566a;
    margin-bottom: 4px;
}

#OpenScannerBtn {
    color: #88c0d0;
    border-color: #88c0d0;
}

QTabWidget::pane {
    border: 1px solid #4c566a;
    border-radius: 6px;
    background: #3b4252;
}
QTabBar::tab {
    background: #3b4252;
    border: 1px solid #4c566a;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #d8dee9;
}
QTabBar::tab:selected {
    background: #2e3440;
    border-bottom-color: #2e3440;
    color: #88c0d0;
    font-weight: bold;
}

QSplitter::handle {
    background-color: #4c566a;
}
QSplitter::handle:hover {
    background-color: #88c0d0;
}
