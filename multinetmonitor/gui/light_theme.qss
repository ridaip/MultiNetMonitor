QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: 'Inter', 'Segoe UI', 'Roboto', sans-serif;
    font-size: 13px;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 10px;
    color: #334155;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #f1f5f9;
    border: 1px solid #0284c7;
    color: #0284c7;
}
QPushButton:pressed {
    background-color: #0284c7;
    color: #ffffff;
}

#EditBtn {
    border: 1px solid #cbd5e1;
    color: #0284c7;
    background-color: #ffffff;
}
#EditBtn:hover {
    background-color: rgba(2, 132, 199, 0.1);
    border-color: #0284c7;
}

#PinBtn {
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    color: #334155;
}
#PinBtn:checked {
    background-color: rgba(2, 132, 199, 0.15);
    border: 1px solid #0284c7;
    color: #0284c7;
}

#DeleteBtn {
    border: 1px solid #f87171;
    background-color: rgba(239, 68, 68, 0.1);
    color: #dc2626;
}
#DeleteBtn:hover {
    background-color: #dc2626;
    color: #ffffff;
}

#CloseBtn {
    border: none;
    background: transparent;
    font-size: 14px;
    color: #64748b;
    border-radius: 4px;
}
#CloseBtn:hover {
    background-color: #dc2626;
    color: #ffffff;
}

#ToolBtn {
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
    color: #334155;
}
#ToolBtn:hover {
    border-color: #0284c7;
    color: #0284c7;
}

QLineEdit, QComboBox, QTableWidget {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px;
    color: #0f172a;
}
QLineEdit:focus, QComboBox:focus, QTableWidget:focus {
    border: 1px solid #0284c7;
    outline: none;
}

QGroupBox {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #0284c7;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #0284c7;
    border: none;
    border-right: 1px solid #cbd5e1;
    padding: 6px;
    font-weight: bold;
}

QProgressBar {
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    text-align: center;
    background-color: #f1f5f9;
    color: #334155;
}
QProgressBar::chunk {
    background-color: #0284c7;
    border-radius: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
}
QCheckBox::indicator:checked {
    background: #0284c7;
    border-color: #0284c7;
}

#TargetRow {
    background-color: #ffffff;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    margin-bottom: 4px;
}

#OpenScannerBtn {
    color: #0284c7;
    border-color: #0284c7;
}

QTabWidget::pane {
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
}
QTabBar::tab {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #64748b;
}
QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
    color: #0284c7;
    font-weight: bold;
}

QSplitter::handle {
    background-color: #cbd5e1;
}
QSplitter::handle:hover {
    background-color: #0284c7;
}
